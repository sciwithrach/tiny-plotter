{
  "name": "tiny-plotter",
  "dockerComposeFile": "../compose.yml",
  "service": "python",
  "workspaceFolder": "/home/jovyan/workspace",
  "forwardPorts": [8787, 8888],
  "portsAttributes": {
    "8787": {
      "label": "RStudio",
      "onAutoForward": "openBrowser"
    },
    "8888": {
      "label": "Jupyter",
      "onAutoForward": "openBrowser"
    }
  },
  "shutdownAction": "stopCompose"
}
